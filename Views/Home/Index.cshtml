@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-4 mb-4 bg-white rounded-3 shadow-sm border">
    <h1 class="display-6 fw-bold mb-1">Library Management System</h1>
    <p class="text-muted mb-0">Gestión centralizada de libros, autores, categorías, miembros y préstamos conectada a PostgreSQL.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Books</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.BooksCount</h2>
                </div>
                <i class="bi bi-journal-bookmark fs-1 text-primary"></i>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Manage Books</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Authors</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.AuthorsCount</h2>
                </div>
                <i class="bi bi-pen fs-1 text-success"></i>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-controller="Authors" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Manage Authors</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Categories</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.CategoriesCount</h2>
                </div>
                <i class="bi bi-tags fs-1 text-info"></i>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-controller="Categories" asp-action="Index" class="btn btn-sm btn-outline-info w-100">Manage Categories</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Members</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.MembersCount</h2>
                </div>
                <i class="bi bi-people fs-1 text-secondary"></i>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-controller="Members" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">Manage Members</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Loans (Active: @ViewBag.ActiveLoansCount)</h6>
                    <h2 class="fw-bold mb-0">@ViewBag.LoansCount</h2>
                </div>
                <i class="bi bi-arrow-left-right fs-1 text-warning"></i>
            </div>
            <div class="card-footer bg-white border-0">
                <a asp-controller="Loans" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">Manage Loans</a>
            </div>
        </div>
    </div>
</div>