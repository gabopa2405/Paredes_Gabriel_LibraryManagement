@model Paredes_Gabriel_LibraryManagement.Models.Category
@{ ViewData["Title"] = "Delete Category"; }

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white fw-bold">Confirm Delete Category</div>
    <div class="card-body">
        <p>Are you sure you want to delete this category?</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Genre Name</dt>
            <dd class="col-sm-9">@Model.GenreName</dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        <form asp-action="Delete">
            <input type="hidden" asp-for="GenreId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>