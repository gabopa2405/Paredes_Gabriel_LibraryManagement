@model Paredes_Gabriel_LibraryManagement.Models.Author
@{ ViewData["Title"] = "Delete Author"; }

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white fw-bold">Confirm Delete Author</div>
    <div class="card-body">
        <p>Are you sure you want to delete this author?</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Biography</dt>
            <dd class="col-sm-9">@(Model.Bio ?? "N/A")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        <form asp-action="Delete">
            <input type="hidden" asp-for="AuthorId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>